# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# App
APP_NAME=Instrumenta API
ENV=dev                       # dev | prod
DEBUG=true
API_PREFIX=/api/v1

# Database / cache (compose overrides host to service names)
DATABASE_URL=postgresql+psycopg2://admin:adminpassword@localhost:5432/dentalsaas
REDIS_URL=redis://localhost:6379/0

# CORS — your frontend origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_MODE=true                # lets the frontend work without login; turn OFF in prod
DEMO_USER_EMAIL=demo@instrumenta.app

# AI (name standardization / OCR). Leave key blank to use the local matcher.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Scraping
SCRAPER_MODE=mock             # mock (seeded catalog) | live (real Playwright scrapers)
PROXY_URL=                    # e.g. http://user:pass@proxy-host:8000
SCRAPE_RATE_LIMIT_SECONDS=2.0
CACHE_TTL_HOURS=24

# Uploads
MAX_UPLOAD_MB=8

# Lifecycle (prod: run Alembic instead of auto-create, and disable seeding)
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
