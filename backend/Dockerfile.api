# Production API image — slim, non-root, health-checked.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app ./app
COPY worker ./worker
COPY alembic.ini ./
COPY migrations ./migrations

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

# Render (e outros PaaS) injetam a porta em $PORT; caímos p/ 8000 rodando local.
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT:-8000}/health" || exit 1

# Shell form + exec: expande $PORT e mantém o gunicorn como PID 1 (recebe SIGTERM).
# Dev sobrescreve com uvicorn --reload; prod roda gunicorn.
CMD ["sh", "-c", "exec gunicorn app.main:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT:-8000} -w 2 --timeout 60 --access-logfile -"]
